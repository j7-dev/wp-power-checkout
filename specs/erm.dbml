// Power Checkout — Entity Relationship Model
// Version: 1.4.0 | Date: 2026-06-18
// 1.4.0: 新增 normalized_error_code enum（einvoice 導入：正規化錯誤碼，發票 + 金流共用，10 值）
//        為「回傳值」值域（\WP_Error $code），非持久化狀態 — 不新增資料表、不新增 order meta key
//        單一事實來源 inc/classes/Shared/Errors/ErrorCode.php，HTTP 映射見各 note
// 1.3.0: 新增 Logistics domain（綠界全方位物流 v2 / AllInOne，provider id=ecpay_logistics）相關
//        物流子類型 enum、帳號類型 enum、物流貨態 enum、付款情境 enum、物流 order meta、wp_options 物流設定表
//        統一抽象 ILogisticsProvider（鏡像 IInvoiceService），設計可容 PAYUNi（本次只實作 ECPay）
// 1.2.0: 新增綠界 ECPay 金流（AIO ecpay_aio / ECPG ecpay_ecpg）+ 綠界電子發票（ecpay）相關
//        order meta、付款方式 enum、整合模式 enum、invoice provider enum、wp_options 設定表
// 本外掛不建立自訂資料表，使用 WooCommerce 訂單 (HPOS / wp_posts) 和 wp_options 儲存資料
// 所有 meta 透過 WC_Order::update_meta_data / get_meta 存取

// ==================== Enums ====================

Enum payment_method {
  CreditCard [note: '信用卡（一次付清/分期）']
  VirtualAccount [note: 'ATM 銀行轉帳']
  JKOPay [note: '街口支付']
  ApplePay [note: 'Apple Pay']
  LinePay [note: 'LINE Pay']
  ChaileaseBNPL [note: '中租 zingla 零卡分期']
}

// 綠界 ECPay ChoosePayment 付款方式（對齊 EcpayPaymentMethod enum value）
// CreditInstallment / Period 對綠界皆屬 ChoosePayment=Credit，僅作業務語意層區分
Enum ecpay_payment_method {
  Credit [note: '信用卡一次付清（ChoosePayment=Credit）']
  CreditInstallment [note: '信用卡分期（ChoosePayment=Credit + CreditInstallment=3,6,12,18,24,30）']
  Period [note: '定期定額（ChoosePayment=Credit + PeriodAmount/PeriodType/Frequency/ExecTimes）']
  WebATM [note: '網路 ATM']
  ATM [note: '自動櫃員機（ATM 虛擬帳號，取號後繳費）']
  CVS [note: '超商代碼（取號後繳費）']
  BARCODE [note: '超商條碼（取號後繳費）']
  ApplePay [note: 'Apple Pay']
}

// 綠界 ECPay 整合模式（每模式一個 WC gateway）
Enum ecpay_integration_mode {
  aio [note: '全方位金流（導轉式 Cashier V5，CheckMacValue SHA256）gateway id=ecpay_aio']
  ecpg [note: '站內付 2.0（內嵌式，AES-128-CBC + 3DS ThreeDURL）gateway id=ecpay_ecpg']
}

// 綠界 AIO 付款 / 取號回應碼 RtnCode（CMV 類服務一律「字串」比對）
Enum ecpay_aio_rtn_code {
  "1" [note: '付款成功（信用卡/ATM/CVS/BARCODE 付款完成最終通知）→ processing']
  "2" [note: 'ATM 取號成功（取得虛擬帳號，尚未付款）→ 不改狀態']
  "10100073" [note: 'CVS/BARCODE 取號成功（取得繳費代碼/條碼，尚未付款）→ 不改狀態']
}

// 電子發票 Provider 值域（Amego + 綠界發票 + ezPay 三者並存，後台可切換）
Enum invoice_provider {
  amego [note: '光貿電子發票（gateway id=amego，md5 簽章）']
  ecpay [note: '綠界電子發票 B2C/B2B（gateway id=ecpay，AES-128-CBC + base64）']
  ezpay [note: 'ezPay 電子發票 B2C/B2B（藍新 NewebPay，gateway id=ezpay，AES-256-CBC + hex + CheckCode SHA256）']
}

// ---- Logistics（綠界全方位物流 v2 / AllInOne）----

// 物流 Provider 值域（統一抽象 ILogisticsProvider；本次只實作 ecpay_logistics，預留 payuni）
Enum logistics_provider {
  ecpay_logistics [note: '綠界全方位物流 v2（AllInOne，AES-128-CBC + JSON，/Express/v2/）']
  // payuni_logistics [note: '預留：PAYUNi 物流（ship_map + trade，AES-256-GCM）— 本次不實作']
}

// 綠界物流子類型 LogisticsSubType（對應結帳頁 WC_Shipping_Method 選項）
Enum logistics_sub_type {
  FAMI [note: '全家超商取貨']
  UNIMART [note: '統一超商（7-11）取貨']
  HILIFE [note: '萊爾富超商取貨']
  HOME [note: '宅配（黑貓，含溫層 Temperature）']
}

// 綠界物流帳號類型（同一 provider 內以 account_type 切換兩組憑證）
Enum logistics_account_type {
  b2c [note: 'B2C 大宗寄倉（測試帳號 MerchantID 2000132）']
  c2c [note: 'C2C 店到店（測試帳號 MerchantID 2000933，HashKey/HashIV 各異）']
}

// 宅配溫層 Temperature（綠界全方位物流 v2）
Enum logistics_temperature {
  "0001" [note: '常溫']
  "0002" [note: '冷藏']
  "0003" [note: '冷凍']
}

// 物流付款情境（結帳頁顧客選擇，決定建單是否帶代收貨款）
Enum logistics_payment_scenario {
  online [note: '線上付款（既有金流 gateway，建物流單 IsCollection=N）']
  cod [note: '取貨付款 COD（IsCollection=Y + CollectionAmount=訂單金額，門市取貨時付款）']
}

// 物流貨態（_pc_logistics_status 儲存綠界 LogisticsStatus 原始碼字串；不直接映射 WC 訂單狀態，與金流 StatusManager 解耦）
// 以下為代表性碼值，實際碼值以綠界文件為準；cancelled 為本系統取消 C2C 物流單後的標記值
Enum logistics_status {
  "300" [note: '物流單已建立 / 已出貨（代表性）']
  "2067" [note: '超商取件完成（代表性；COD 訂單觸發取貨付款完成標記）']
  cancelled [note: '本系統取消 C2C 物流單後的標記']
}

Enum slp_response_status {
  CREATED [note: '任務已創建']
  CUSTOMER_ACTION [note: '顧客處理中']
  PROCESSING [note: '內部處理中']
  PENDING [note: '處理中']
  SUCCEEDED [note: '成功']
  EXPIRED [note: '已過期']
  FAILED [note: '失敗']
  CANCELLED [note: '已取消']
}

Enum order_status {
  pending [note: '等待付款中']
  processing [note: '處理中（已付款）']
  on_hold [note: '保留']
  completed [note: '已完成']
  cancelled [note: '已取消']
  refunded [note: '已退款']
  failed [note: '失敗']
  checkout_draft [note: '草稿']
}

Enum provider_mode {
  test [note: '測試/沙箱模式']
  prod [note: '正式模式']
}

Enum invoice_type {
  individual [note: '個人']
  company [note: '公司']
  donate [note: '捐贈']
}

Enum individual_type {
  cloud [note: '雲端發票']
  barcode [note: '手機條碼']
  moica [note: '自然人憑證']
  paper [note: '紙本發票']
}

Enum tax_type {
  1 [note: '應稅']
  2 [note: '零稅率']
  3 [note: '免稅']
}

// ---- 正規化錯誤碼（領域中立，發票 + 金流共用）----

// 正規化錯誤碼值域（einvoice 導入：把各 provider 原始錯誤碼歸一為 10 個固定 code，
// 讓呼叫端能判斷失敗類型、前端能精確顯示、REST 層能映射為適當 HTTP 狀態碼）。
// ⚠️ 這是「回傳值」（\WP_Error $code）的值域，非持久化狀態：
//    不對應任何資料表 / order meta key（錯誤不寫入 DB，僅作為 REST 回應的 error_code 欄位）。
// 單一事實來源：inc/classes/Shared/Errors/ErrorCode.php（backed enum string，value = case 名）；
//    REST 映射由 ErrorCode::to_http_status() 落實，與下方 note 的 HTTP 對齊。
Enum normalized_error_code {
  AUTH [note: '認證失敗（發票：金鑰/JWT/商店憑證錯，如 ezPay KEY10002；金流：商店憑證/簽章金鑰錯）→ HTTP 401']
  VALIDATION [note: '驗證失敗（發票：UBN checksum/載具捐贈互斥/金額守恆；金流：退款金額不合法/必填缺）→ HTTP 422']
  NOT_FOUND [note: '查無資源（發票：查無發票；金流：查無交易）→ HTTP 404']
  CONFLICT [note: '狀態衝突（發票：重複開立/已作廢/已開折讓，如 ezPay LIB10007；金流：重複處理/狀態衝突）→ HTTP 409']
  NUMBER_EXHAUSTED [note: '字軌號碼用罄（發票專屬）→ HTTP 409']
  SIGNATURE [note: '驗章失敗（發票：CheckCode；金流：CheckMacValue/HMAC/HashInfo 不符；PC 新增於 einvoice 9 種之外）→ HTTP 400。⚠️ callback 驗簽失敗僅內部標記 + 記 order note，HTTP 永遠 200，不走此映射']
  UNSUPPORTED [note: '不支援的操作（發票：不支援折讓/查詢；金流：退款不支援/capture/void no-op）→ HTTP 400']
  NETWORK [note: '連線失敗（發票 + 金流共用：API 連線失敗/逾時/無回應）→ HTTP 502']
  PROVIDER [note: 'provider 回未分類錯誤碼（發票 + 金流共用：映射表未涵蓋，保留 raw_code 供 debug）→ HTTP 502']
  UNKNOWN [note: '未預期 \Throwable（發票 + 金流共用：never-throw 鐵律下 driver 例外一律歸此）→ HTTP 500']
}

// ==================== WooCommerce 核心資料表（參考用）====================

Table wc_orders {
  id bigint [pk, note: '訂單 ID（HPOS 模式使用 wc_orders 表，傳統模式使用 wp_posts.ID）']
  status order_status [note: '訂單狀態']
  payment_method varchar [note: '付款方式 ID（如 shopline_payment_redirect）']
  payment_method_title varchar [note: '付款方式標題']
  total decimal [note: '訂單總額']

  Note: '''
    WooCommerce 訂單
    HPOS 模式使用 wc_orders 表，傳統模式使用 wp_posts
    Power Checkout 僅讀寫 order meta，不修改表結構
  '''
}

// ==================== wp_options 設定表 ====================

Table wp_options_slp_settings {
  option_name varchar [pk, note: 'woocommerce_shopline_payment_redirect_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  order_button_text varchar [note: '付款按鈕文字']
  mode provider_mode [note: 'test / prod']
  platformId varchar [note: 'SLP 平台 ID']
  merchantId varchar [note: 'SLP 特店 ID']
  apiKey varchar [note: 'API 介面金鑰']
  clientKey varchar [note: '客戶端金鑰']
  signKey varchar [note: 'Webhook 簽名密鑰']
  apiUrl varchar [note: 'SLP API 端點 URL']
  allowPaymentMethodList json [note: '允許的付款方式 array（CreditCard, VirtualAccount, LinePay 等）']
  paymentMethodOptions json [note: '付款方式選項（分期期數等；LINE Pay 不需要 paymentMethodOptions）']
  expire_min int [note: '付款期限（分鐘），預設 360']
  min_amount int [note: '最小金額，不得低於 5']
  max_amount int [note: '最大金額，不得超過 50000']

  Note: '''
    Shopline Payment 跳轉支付設定
    儲存在 wp_options，option_name = woocommerce_shopline_payment_redirect_settings
    值為 PHP serialized array
    對應 .feature: settings/provider-settings（ShoplinePaymentSettings schema）
  '''
}

Table wp_options_amego_settings {
  option_name varchar [pk, note: 'woocommerce_amego_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  method_title varchar [note: '方法標題']
  mode provider_mode [note: 'test / prod']
  invoice varchar [note: '商家統一編號']
  app_key varchar [note: '光貿 API 金鑰']
  tax_rate float [note: '稅率，預設 0.05']
  auto_issue_order_statuses json [note: '自動開立發票的訂單狀態列表（如 ["wc-processing"]）']
  auto_cancel_order_statuses json [note: '自動作廢發票的訂單狀態列表（如 ["wc-refunded"]）']

  Note: '''
    光貿電子發票設定
    儲存在 wp_options，option_name = woocommerce_amego_settings
    值為 PHP serialized array
    對應 .feature: settings/provider-settings（AmegoSettings schema）
  '''
}

Table wp_options_ecpay_aio_settings {
  option_name varchar [pk, note: 'woocommerce_ecpay_aio_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題（預設「綠界 ECPay 全方位金流」）']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  orderButtonText varchar [note: '付款按鈕文字（預設「前往綠界付款」）']
  mode provider_mode [note: 'test / prod']
  merchantId varchar [note: '綠界特店編號 MerchantID（憑證存 DB，禁寫死正式憑證）']
  hashKey varchar [note: '綠界 HashKey（憑證存 DB）']
  hashIv varchar [note: '綠界 HashIV（憑證存 DB）']
  allowedPayments json [note: '允許的付款方式 array（ecpay_payment_method 子集；組裝固定送 ChoosePayment=ALL 再反推 IgnorePayment）']
  installmentPeriods json [note: '信用卡分期期數 array（預設 [3,6,12,18,24,30]）']
  periodConfig json [note: '定期定額設定（PeriodAmount/PeriodType/Frequency/ExecTimes；空陣列=不啟用）']
  minAmount int [note: '最小金額（0 表示不限制）']
  maxAmount int [note: '最大金額（0 表示不限制）']
  expireDate int [note: 'ATM 繳費天數（範圍 1-60，預設 3）']

  Note: '''
    綠界 ECPay 全方位金流（AIO 導轉式）設定
    儲存在 wp_options，option_name = woocommerce_ecpay_aio_settings，值為 PHP serialized array
    test 模式未填憑證時套用綠界 AIO 公開測試帳號（MerchantID 3002607 / SHA256）
    對應 .feature: payment/ecpay-aio-checkout（AioSettingsDTO）
  '''
}

Table wp_options_ecpay_ecpg_settings {
  option_name varchar [pk, note: 'woocommerce_ecpay_ecpg_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題（預設「綠界 ECPay 站內付」）']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  method_title varchar [note: '後台標題']
  method_description varchar [note: '後台描述']
  orderButtonText varchar [note: '付款按鈕文字（預設「確認付款」）']
  mode provider_mode [note: 'test / prod']
  merchantId varchar [note: '綠界特店編號 MerchantID（憑證存 DB）']
  hashKey varchar [note: '綠界 HashKey（憑證存 DB）']
  hashIv varchar [note: '綠界 HashIV（憑證存 DB）']
  allowedPayments json [note: '允許的付款方式 array（站內付 2.0 本階段預設僅 Credit）']
  minAmount int [note: '最小金額（0 表示不限制）']
  maxAmount int [note: '最大金額（0 表示不限制）']

  Note: '''
    綠界 ECPay 站內付 2.0（ECPG 內嵌式）設定
    儲存在 wp_options，option_name = woocommerce_ecpay_ecpg_settings，值為 PHP serialized array
    test 模式未填憑證時套用綠界 ECPG 線上金流公開測試帳號（MerchantID 3002607 / AES-128-CBC）
    雙 Domain：Token/CreatePayment 走 ecpg；查詢/退款走 ecpayment（混用會 404）
    對應 .feature: payment/ecpay-ecpg-checkout（EcpgSettingsDTO）
  '''
}

Table wp_options_ecpay_invoice_settings {
  option_name varchar [pk, note: 'woocommerce_ecpay_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題（預設「綠界電子發票」）']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  method_title varchar [note: '標題']
  method_description varchar [note: '描述']
  mode provider_mode [note: 'test / prod']
  merchant_id varchar [note: '綠界特店編號 MerchantID（憑證存 DB）']
  hash_key varchar [note: '綠界 HashKey（憑證存 DB）']
  hash_iv varchar [note: '綠界 HashIV（憑證存 DB）']

  Note: '''
    綠界 ECPay 電子發票（B2C/B2B）設定，與 Amego 並列為 Invoice Provider
    儲存在 wp_options，option_name = woocommerce_ecpay_settings（注意：發票 provider id = ecpay，非 ecpay_invoice）
    test 模式未填憑證時套用綠界電子發票公開測試帳號（MerchantID 2000132 / AES-128-CBC）
    對應 .feature: invoice/invoice-issue、invoice/invoice-cancel（綠界 provider 情境）
  '''
}

Table wp_options_ezpay_invoice_settings {
  option_name varchar [pk, note: 'woocommerce_ezpay_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題（預設「ezPay 電子發票」）']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  method_title varchar [note: '標題']
  method_description varchar [note: '描述']
  mode provider_mode [note: 'test / prod（test=cinv.ezpay.com.tw，prod=inv.ezpay.com.tw）']
  merchant_id varchar [note: 'ezPay 商店代號 MerchantID（憑證存 DB；傳輸時帶 MerchantID_ 明文）']
  hash_key varchar [note: 'ezPay HashKey 32 bytes（憑證存 DB）']
  hash_iv varchar [note: 'ezPay HashIV 16 bytes（憑證存 DB）']
  auto_issue_order_statuses json [note: '自動開立發票的訂單狀態列表（預設 ["wc-processing"]）']
  auto_cancel_order_statuses json [note: '自動作廢發票的訂單狀態列表（預設 ["wc-refunded"]）']
  auto_allowance_on_refund varchar [note: '部分退款時自動開立折讓（yes / no，預設 no）']

  Note: '''
    ezPay 電子發票（藍新 NewebPay）B2C/B2B 設定，與 Amego、綠界發票並列為 Invoice Provider
    儲存在 wp_options，option_name = woocommerce_ezpay_settings（發票 provider id = ezpay）
    加密 AES-256-CBC（HashKey 32 bytes / HashIV 16 bytes / PKCS#7 blocksize 32 / hex），回應 CheckCode SHA256 驗章
    憑證一律存 DB，禁止寫死正式憑證（測試帳號由 ezPay 測試平台 cinv.ezpay.com.tw 申請取得）
    對應 .feature: invoice/invoice-issue、invoice/invoice-cancel（ezPay provider 情境）、invoice/ezpay-invoice-allowance、invoice/ezpay-invoice-query
  '''
}

Table wp_options_ecpay_logistics_settings {
  option_name varchar [pk, note: 'woocommerce_ecpay_logistics_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題（預設「綠界超商取貨 / 宅配」）']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  method_title varchar [note: '後台標題']
  mode provider_mode [note: 'test / prod']
  account_type logistics_account_type [note: '帳號類型 b2c / c2c（決定使用哪組憑證）']
  b2c_merchant_id varchar [note: 'B2C 綠界特店編號（憑證存 DB，禁寫死正式憑證）']
  b2c_hash_key varchar [note: 'B2C HashKey（憑證存 DB）']
  b2c_hash_iv varchar [note: 'B2C HashIV（憑證存 DB）']
  c2c_merchant_id varchar [note: 'C2C 綠界特店編號（憑證存 DB）']
  c2c_hash_key varchar [note: 'C2C HashKey（憑證存 DB）']
  c2c_hash_iv varchar [note: 'C2C HashIV（憑證存 DB）']
  enabled_methods json [note: '啟用的物流子類型 array（logistics_sub_type 子集，如 ["FAMI","UNIMART","HILIFE","HOME"]）']
  sender_name varchar [note: '寄件人姓名']
  sender_phone varchar [note: '寄件人電話']
  sender_zip_code varchar [note: '寄件人郵遞區號']
  sender_address varchar [note: '寄件人地址']
  server_reply_url varchar [note: '貨態 callback URL（ServerReplyURL，僅 80/443 port）']
  client_reply_url varchar [note: '選店回呼 URL（ClientReplyURL，需公開可訪問）']

  Note: '''
    綠界 ECPay 全方位物流 v2（AllInOne）設定，Logistics domain 新 provider
    儲存在 wp_options，option_name = woocommerce_ecpay_logistics_settings，值為 PHP serialized array
    test 模式未填憑證時套用綠界物流公開測試帳號（B2C 2000132 / C2C 2000933，AES-128-CBC）
    account_type 切換 B2C / C2C 兩組憑證；憑證複用既有 Payment\\Ecpg AES-128-CBC AesCrypto（同套加密）
    對應 .feature: logistics/logistics-store-selection、logistics-create-shipment 等（EcpayLogisticsSettingsDTO）
  '''
}

Table wp_options_global_settings {
  option_name varchar [pk, note: 'power_checkout_settings']
  value json [note: '全域設定（目前保留未使用）']

  Note: '''
    Power Checkout 全域設定
    儲存在 wp_options，option_name = power_checkout_settings
  '''
}

// ==================== WC_Order Meta: 金流 ====================

Table wc_order_meta_payment {
  order_id bigint [ref: > wc_orders.id, note: '訂單 ID']
  _pc_identity varchar [note: '第三方金流識別碼（SLP sessionId）']
  _pc_payment_identity varchar [note: '付款識別碼（SLP tradeOrderId），用於 Webhook 對應訂單與防重複處理']
  _pc_payment_detail json [note: '付款詳情 array（Webhook 付款成功時寫入）']
  _pc_refund_detail json [note: '退款詳情 array（Webhook 退款成功時寫入）']
  tmp_refund_reason varchar [note: '暫存退款原因（Gateway 退款時寫入，Webhook 退款成功後刪除）']

  Note: '''
    金流相關的 Order Meta
    對應 .feature: payment/shopline-payment-checkout、payment/shopline-payment-webhook、payment/refund-gateway
    透過 Payment\Shared\Helpers\MetaKeys 類別存取
    _pc_payment_identity 用於 Webhook 透過 tradeOrderId 查找訂單
  '''
}

// ==================== WC_Order Meta: 金流（綠界 ECPay）====================

Table wc_order_meta_ecpay_payment {
  order_id bigint [ref: > wc_orders.id, note: '訂單 ID']
  _pc_ecpay_trade_no varchar [note: '綠界 MerchantTradeNo（冪等鍵，建單時寫入；ReturnURL/PaymentInfoURL 以此反查訂單）']
  _pc_ecpay_payment_detail json [note: '付款結果明細（ReturnURL 幕後通知寫入；AIO=已驗章參數陣列 / ECPG=AES 解密後的 Data）']
  _pc_ecpay_payment_info json [note: '取號繳費資訊（PaymentInfoURL 通知寫入：BankCode/vAccount/PaymentNo/Barcode1-3/ExpireDate 等）']
  _pc_ecpay_credit_variant varchar [note: "信用卡付款變體（''｜'installment'｜'period'，checkout 顧客選擇寫入）"]
  _pc_ecpay_installment varchar [note: "信用卡分期期數（顧客選擇的單一期數，如 '6'，checkout 寫入）"]

  Note: '''
    綠界 ECPay 金流相關的 Order Meta（AIO + ECPG 共用同一組 meta key）
    對應 .feature: payment/ecpay-aio-checkout、ecpay-aio-callback、ecpay-aio-payment-info、
                   ecpay-ecpg-checkout、ecpay-ecpg-callback、ecpay-credit-variants、ecpay-refund
    透過 Payment\\EcpayAIO\\Shared\\Helpers\\EcpayMetaKeys 類別存取（HPOS 相容，禁用 get_post_meta）
    _pc_ecpay_trade_no 為冪等鍵：幕後通知（ReturnURL/PaymentInfoURL）以 MerchantTradeNo 反查訂單，
    已 processing 則 skip（重送風暴防護）
  '''
}

// ==================== WC_Order Meta: 金流（PAYUNi UNi Embed V3 內嵌式）====================

Table wc_order_meta_payuni_uni_payment {
  order_id bigint [ref: > wc_orders.id, note: '訂單 ID']
  _pc_payuni_uni_trade_no varchar [note: 'MerTradeNo 冪等鍵（前綴 PCE；merchant_trade 階段才產生，NotifyURL 以此反查訂單）。⚠️ V3：token_get 階段不送訂單，MerTradeNo 在 merchant_trade 才送']
  _pc_payuni_uni_sdk_token varchar [note: 'token_get 取得的 SDK_TOKEN（10 分鐘有效，供前端 uniPayment SDK + 後端 merchant_trade 共用同一個）']
  _pc_payuni_uni_payment_detail json [note: 'merchant_trade / NotifyURL 解密後付款結果（AES-256-GCM 解密後的授權結果，含 TradeNo / Gateway=9 / PaymentType=1 / AuthCode / TradeStatus 等）']
  _pc_payuni_uni_capture_status varchar [note: "信用卡請款 / 取消授權狀態（''｜'captured'｜'voided'）"]
  _pc_payuni_uni_credit_hash varchar [note: '買方 Token Hash（CreditHash，授權成功且帶 CreditToken 才壓碼）。⚠️ 僅存 hash，絕不存卡號 / CVC']
  _pc_payuni_uni_credit_life varchar [note: '買方 Token 有效日期（CreditLife，MMYY 格式）']

  Note: '''
    PAYUNi UNi Embed V3（內嵌式信用卡）金流相關的 Order Meta
    與既有 PAYUNi UPP 的 _pc_payuni_* meta key 隔離，前綴一律 _pc_payuni_uni_
    對應 .feature: payment/payuni-uni-embed-checkout、payuni-uni-embed-create-payment、
                   payuni-uni-embed-callback、payuni-uni-embed-refund、
                   payuni-uni-embed-trade-management、payuni-uni-embed-token-management
    透過 Payment\\PayuniUniEmbed\\Shared\\Helpers\\(MetaKeys) 類別存取（HPOS 相容，禁用 get_post_meta）
    加密複用 Payment\\Payuni\\Shared\\Helpers\\PayuniCrypto（AES-256-GCM + SHA256 HashInfo，與 UPP 完全相同）
    _pc_payuni_uni_trade_no 為冪等鍵：NotifyURL 幕後通知以 MerTradeNo 反查訂單，已 processing 則 skip（重送防護）
    安全硬約束：僅保存 PAYUNi 回傳的 Token Hash 與有效日期，絕不保存卡號 / CVC
  '''
}

// ==================== WC_Order Meta: 發票 ====================

Table wc_order_meta_invoice {
  order_id bigint [ref: > wc_orders.id, note: '訂單 ID']
  _pc_issue_invoice_params json [note: '結帳頁填寫的發票資訊（invoiceType, individual, carrier, companyId 等）']
  _pc_issued_invoice_data json [note: '發票開立回傳資料 array（含 invoice_number 等；ezPay 另含 invoice_trans_no / random_num）']
  _pc_cancelled_invoice_data json [note: '發票作廢回傳資料 array']
  _pc_allowance_data json [note: '開立折讓回傳資料 array（部分退款折讓單；ezPay 含 allowance_no）']
  _pc_invoice_provider_id invoice_provider [note: '使用的發票 Provider ID（amego ｜ ecpay ｜ ezpay）']

  Note: '''
    電子發票相關的 Order Meta（Amego、綠界 ECPay、ezPay 發票共用同一組 meta key）
    對應 .feature: invoice/invoice-issue、invoice/invoice-cancel、invoice/ezpay-invoice-allowance、invoice/ezpay-invoice-query
    透過 Invoice\Shared\Helpers\MetaKeys 類別存取（provider-agnostic，ezPay 沿用不新增 meta key）
    _pc_invoice_provider_id 值域對應 Enum invoice_provider（amego ｜ ecpay ｜ ezpay）
    ezPay 的 InvoiceTransNo / InvoiceNumber / RandomNum 存於 _pc_issued_invoice_data JSON 內，AllowanceNo 存於 _pc_allowance_data
    作廢成功時清除 _pc_issue_invoice_params、_pc_issued_invoice_data、_pc_invoice_provider_id
  '''
}

// ==================== WC_Order Meta: 物流（綠界全方位物流 v2）====================

Table wc_order_meta_logistics {
  order_id bigint [ref: > wc_orders.id, note: '訂單 ID']
  _pc_logistics_provider_id logistics_provider [note: '使用的物流 Provider ID（ecpay_logistics）']
  _pc_logistics_sub_type logistics_sub_type [note: '物流子類型（FAMI/UNIMART/HILIFE/HOME），結帳選擇寫入']
  _pc_logistics_payment_scenario logistics_payment_scenario [note: '付款情境（online / cod），結帳選擇寫入']
  _pc_logistics_temp_id varchar [note: '暫存物流單號 TempLogisticsID（選店回呼 ClientReplyURL 寫入；成立物流單的必要憑證）']
  _pc_logistics_ref varchar [note: '統一物流單號（= 綠界 LogisticsID / 未來 PAYUNi ShipTradeNo；成立物流單後寫入；下游主鍵）']
  _pc_logistics_store_id varchar [note: '選定門市代碼（超商，選店回呼寫入）']
  _pc_logistics_store_name varchar [note: '選定門市名稱（超商）']
  _pc_logistics_store_addr varchar [note: '選定門市地址（超商）']
  _pc_logistics_status logistics_status [note: '物流貨態（ServerReplyURL 貨態 callback 寫入綠界 LogisticsStatus；防重亦記已處理碼）']
  _pc_logistics_cvs_payment_no varchar [note: 'C2C 寄貨編號 CVSPaymentNo（C2C 成立物流單後寫入；取消單需用）']
  _pc_logistics_cvs_validation_no varchar [note: 'C2C 驗證碼 CVSValidationNo（C2C 成立物流單後寫入；取消單需用）']
  _pc_logistics_collection_paid varchar [note: 'COD 取貨付款完成標記（yes；取件完成貨態時寫入）']

  Note: '''
    綠界全方位物流相關的 Order Meta（統一抽象 ILogisticsProvider 共用同一組 meta key）
    對應 .feature: logistics/logistics-store-selection、logistics-selection-callback、
                   logistics-create-shipment、logistics-status-callback、logistics-query、
                   logistics-print-document、logistics-cancel-c2c
    透過 Logistics\\Shared\\Helpers\\LogisticsMetaKeys 類別存取（HPOS 相容，禁用 get_post_meta）
    _pc_logistics_ref 為統一主鍵：貨態 callback（ServerReplyURL）以 LogisticsID 反查訂單，防重以已處理碼為 key
    _pc_logistics_collection_paid 僅 COD 訂單於取件完成貨態時標記
  '''
}

// ==================== WC_Order_Item Meta ====================

Table wc_order_item_meta {
  order_item_id bigint [note: '訂單項目 ID']
  _pc_tax_type int [note: '商品稅別（1=應稅, 2=零稅率, 3=免稅），預設 1']

  Note: '''
    訂單商品項目的稅別
    透過 WC_Order_Item::get_meta("_pc_tax_type") 存取
    對應 Enum tax_type，用於發票開立時計算稅額
  '''
}

// ==================== References ====================

Ref: wc_order_meta_payment.order_id > wc_orders.id
Ref: wc_order_meta_ecpay_payment.order_id > wc_orders.id
Ref: wc_order_meta_payuni_uni_payment.order_id > wc_orders.id
Ref: wc_order_meta_invoice.order_id > wc_orders.id
Ref: wc_order_meta_logistics.order_id > wc_orders.id
