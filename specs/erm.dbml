// Power Checkout — Entity Relationship Model
// Version: 1.2.0 | Date: 2026-06-04
// 1.2.0: 新增綠界 ECPay 金流（AIO ecpay_aio / ECPG ecpay_ecpg）+ 綠界電子發票（ecpay）相關
//        order meta、付款方式 enum、整合模式 enum、invoice provider enum、wp_options 設定表
// 本外掛不建立自訂資料表，使用 WooCommerce 訂單 (HPOS / wp_posts) 和 wp_options 儲存資料
// 所有 meta 透過 WC_Order::update_meta_data / get_meta 存取

// ==================== Enums ====================

Enum payment_method {
  CreditCard [note: '信用卡（一次付清/分期）']
  VirtualAccount [note: 'ATM 銀行轉帳']
  JKOPay [note: '街口支付']
  ApplePay [note: 'Apple Pay']
  LinePay [note: 'LINE Pay']
  ChaileaseBNPL [note: '中租 zingla 零卡分期']
}

// 綠界 ECPay ChoosePayment 付款方式（對齊 EcpayPaymentMethod enum value）
// CreditInstallment / Period 對綠界皆屬 ChoosePayment=Credit，僅作業務語意層區分
Enum ecpay_payment_method {
  Credit [note: '信用卡一次付清（ChoosePayment=Credit）']
  CreditInstallment [note: '信用卡分期（ChoosePayment=Credit + CreditInstallment=3,6,12,18,24,30）']
  Period [note: '定期定額（ChoosePayment=Credit + PeriodAmount/PeriodType/Frequency/ExecTimes）']
  WebATM [note: '網路 ATM']
  ATM [note: '自動櫃員機（ATM 虛擬帳號，取號後繳費）']
  CVS [note: '超商代碼（取號後繳費）']
  BARCODE [note: '超商條碼（取號後繳費）']
  ApplePay [note: 'Apple Pay']
}

// 綠界 ECPay 整合模式（每模式一個 WC gateway）
Enum ecpay_integration_mode {
  aio [note: '全方位金流（導轉式 Cashier V5，CheckMacValue SHA256）gateway id=ecpay_aio']
  ecpg [note: '站內付 2.0（內嵌式，AES-128-CBC + 3DS ThreeDURL）gateway id=ecpay_ecpg']
}

// 綠界 AIO 付款 / 取號回應碼 RtnCode（CMV 類服務一律「字串」比對）
Enum ecpay_aio_rtn_code {
  "1" [note: '付款成功（信用卡/ATM/CVS/BARCODE 付款完成最終通知）→ processing']
  "2" [note: 'ATM 取號成功（取得虛擬帳號，尚未付款）→ 不改狀態']
  "10100073" [note: 'CVS/BARCODE 取號成功（取得繳費代碼/條碼，尚未付款）→ 不改狀態']
}

// 電子發票 Provider 值域（Amego + 綠界發票兩者並存，後台可切換）
Enum invoice_provider {
  amego [note: '光貿電子發票（gateway id=amego，md5 簽章）']
  ecpay [note: '綠界電子發票 B2C/B2B（gateway id=ecpay，AES-128-CBC）']
}

Enum slp_response_status {
  CREATED [note: '任務已創建']
  CUSTOMER_ACTION [note: '顧客處理中']
  PROCESSING [note: '內部處理中']
  PENDING [note: '處理中']
  SUCCEEDED [note: '成功']
  EXPIRED [note: '已過期']
  FAILED [note: '失敗']
  CANCELLED [note: '已取消']
}

Enum order_status {
  pending [note: '等待付款中']
  processing [note: '處理中（已付款）']
  on_hold [note: '保留']
  completed [note: '已完成']
  cancelled [note: '已取消']
  refunded [note: '已退款']
  failed [note: '失敗']
  checkout_draft [note: '草稿']
}

Enum provider_mode {
  test [note: '測試/沙箱模式']
  prod [note: '正式模式']
}

Enum invoice_type {
  individual [note: '個人']
  company [note: '公司']
  donate [note: '捐贈']
}

Enum individual_type {
  cloud [note: '雲端發票']
  barcode [note: '手機條碼']
  moica [note: '自然人憑證']
  paper [note: '紙本發票']
}

Enum tax_type {
  1 [note: '應稅']
  2 [note: '零稅率']
  3 [note: '免稅']
}

// ==================== WooCommerce 核心資料表（參考用）====================

Table wc_orders {
  id bigint [pk, note: '訂單 ID（HPOS 模式使用 wc_orders 表，傳統模式使用 wp_posts.ID）']
  status order_status [note: '訂單狀態']
  payment_method varchar [note: '付款方式 ID（如 shopline_payment_redirect）']
  payment_method_title varchar [note: '付款方式標題']
  total decimal [note: '訂單總額']

  Note: '''
    WooCommerce 訂單
    HPOS 模式使用 wc_orders 表，傳統模式使用 wp_posts
    Power Checkout 僅讀寫 order meta，不修改表結構
  '''
}

// ==================== wp_options 設定表 ====================

Table wp_options_slp_settings {
  option_name varchar [pk, note: 'woocommerce_shopline_payment_redirect_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  order_button_text varchar [note: '付款按鈕文字']
  mode provider_mode [note: 'test / prod']
  platformId varchar [note: 'SLP 平台 ID']
  merchantId varchar [note: 'SLP 特店 ID']
  apiKey varchar [note: 'API 介面金鑰']
  clientKey varchar [note: '客戶端金鑰']
  signKey varchar [note: 'Webhook 簽名密鑰']
  apiUrl varchar [note: 'SLP API 端點 URL']
  allowPaymentMethodList json [note: '允許的付款方式 array（CreditCard, VirtualAccount, LinePay 等）']
  paymentMethodOptions json [note: '付款方式選項（分期期數等；LINE Pay 不需要 paymentMethodOptions）']
  expire_min int [note: '付款期限（分鐘），預設 360']
  min_amount int [note: '最小金額，不得低於 5']
  max_amount int [note: '最大金額，不得超過 50000']

  Note: '''
    Shopline Payment 跳轉支付設定
    儲存在 wp_options，option_name = woocommerce_shopline_payment_redirect_settings
    值為 PHP serialized array
    對應 .feature: settings/provider-settings（ShoplinePaymentSettings schema）
  '''
}

Table wp_options_amego_settings {
  option_name varchar [pk, note: 'woocommerce_amego_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  method_title varchar [note: '方法標題']
  mode provider_mode [note: 'test / prod']
  invoice varchar [note: '商家統一編號']
  app_key varchar [note: '光貿 API 金鑰']
  tax_rate float [note: '稅率，預設 0.05']
  auto_issue_order_statuses json [note: '自動開立發票的訂單狀態列表（如 ["wc-processing"]）']
  auto_cancel_order_statuses json [note: '自動作廢發票的訂單狀態列表（如 ["wc-refunded"]）']

  Note: '''
    光貿電子發票設定
    儲存在 wp_options，option_name = woocommerce_amego_settings
    值為 PHP serialized array
    對應 .feature: settings/provider-settings（AmegoSettings schema）
  '''
}

Table wp_options_ecpay_aio_settings {
  option_name varchar [pk, note: 'woocommerce_ecpay_aio_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題（預設「綠界 ECPay 全方位金流」）']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  orderButtonText varchar [note: '付款按鈕文字（預設「前往綠界付款」）']
  mode provider_mode [note: 'test / prod']
  merchantId varchar [note: '綠界特店編號 MerchantID（憑證存 DB，禁寫死正式憑證）']
  hashKey varchar [note: '綠界 HashKey（憑證存 DB）']
  hashIv varchar [note: '綠界 HashIV（憑證存 DB）']
  allowedPayments json [note: '允許的付款方式 array（ecpay_payment_method 子集；組裝固定送 ChoosePayment=ALL 再反推 IgnorePayment）']
  installmentPeriods json [note: '信用卡分期期數 array（預設 [3,6,12,18,24,30]）']
  periodConfig json [note: '定期定額設定（PeriodAmount/PeriodType/Frequency/ExecTimes；空陣列=不啟用）']
  minAmount int [note: '最小金額（0 表示不限制）']
  maxAmount int [note: '最大金額（0 表示不限制）']
  expireDate int [note: 'ATM 繳費天數（範圍 1-60，預設 3）']

  Note: '''
    綠界 ECPay 全方位金流（AIO 導轉式）設定
    儲存在 wp_options，option_name = woocommerce_ecpay_aio_settings，值為 PHP serialized array
    test 模式未填憑證時套用綠界 AIO 公開測試帳號（MerchantID 3002607 / SHA256）
    對應 .feature: payment/ecpay-aio-checkout（AioSettingsDTO）
  '''
}

Table wp_options_ecpay_ecpg_settings {
  option_name varchar [pk, note: 'woocommerce_ecpay_ecpg_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題（預設「綠界 ECPay 站內付」）']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  method_title varchar [note: '後台標題']
  method_description varchar [note: '後台描述']
  orderButtonText varchar [note: '付款按鈕文字（預設「確認付款」）']
  mode provider_mode [note: 'test / prod']
  merchantId varchar [note: '綠界特店編號 MerchantID（憑證存 DB）']
  hashKey varchar [note: '綠界 HashKey（憑證存 DB）']
  hashIv varchar [note: '綠界 HashIV（憑證存 DB）']
  allowedPayments json [note: '允許的付款方式 array（站內付 2.0 本階段預設僅 Credit）']
  minAmount int [note: '最小金額（0 表示不限制）']
  maxAmount int [note: '最大金額（0 表示不限制）']

  Note: '''
    綠界 ECPay 站內付 2.0（ECPG 內嵌式）設定
    儲存在 wp_options，option_name = woocommerce_ecpay_ecpg_settings，值為 PHP serialized array
    test 模式未填憑證時套用綠界 ECPG 線上金流公開測試帳號（MerchantID 3002607 / AES-128-CBC）
    雙 Domain：Token/CreatePayment 走 ecpg；查詢/退款走 ecpayment（混用會 404）
    對應 .feature: payment/ecpay-ecpg-checkout（EcpgSettingsDTO）
  '''
}

Table wp_options_ecpay_invoice_settings {
  option_name varchar [pk, note: 'woocommerce_ecpay_settings']
  enabled varchar [note: 'yes / no']
  title varchar [note: '前台顯示標題（預設「綠界電子發票」）']
  description text [note: '前台顯示描述']
  icon varchar [note: '圖示 URL']
  method_title varchar [note: '標題']
  method_description varchar [note: '描述']
  mode provider_mode [note: 'test / prod']
  merchant_id varchar [note: '綠界特店編號 MerchantID（憑證存 DB）']
  hash_key varchar [note: '綠界 HashKey（憑證存 DB）']
  hash_iv varchar [note: '綠界 HashIV（憑證存 DB）']

  Note: '''
    綠界 ECPay 電子發票（B2C/B2B）設定，與 Amego 並列為 Invoice Provider
    儲存在 wp_options，option_name = woocommerce_ecpay_settings（注意：發票 provider id = ecpay，非 ecpay_invoice）
    test 模式未填憑證時套用綠界電子發票公開測試帳號（MerchantID 2000132 / AES-128-CBC）
    對應 .feature: invoice/invoice-issue、invoice/invoice-cancel（綠界 provider 情境）
  '''
}

Table wp_options_global_settings {
  option_name varchar [pk, note: 'power_checkout_settings']
  value json [note: '全域設定（目前保留未使用）']

  Note: '''
    Power Checkout 全域設定
    儲存在 wp_options，option_name = power_checkout_settings
  '''
}

// ==================== WC_Order Meta: 金流 ====================

Table wc_order_meta_payment {
  order_id bigint [ref: > wc_orders.id, note: '訂單 ID']
  _pc_identity varchar [note: '第三方金流識別碼（SLP sessionId）']
  _pc_payment_identity varchar [note: '付款識別碼（SLP tradeOrderId），用於 Webhook 對應訂單與防重複處理']
  _pc_payment_detail json [note: '付款詳情 array（Webhook 付款成功時寫入）']
  _pc_refund_detail json [note: '退款詳情 array（Webhook 退款成功時寫入）']
  tmp_refund_reason varchar [note: '暫存退款原因（Gateway 退款時寫入，Webhook 退款成功後刪除）']

  Note: '''
    金流相關的 Order Meta
    對應 .feature: payment/shopline-payment-checkout、payment/shopline-payment-webhook、payment/refund-gateway
    透過 Payment\Shared\Helpers\MetaKeys 類別存取
    _pc_payment_identity 用於 Webhook 透過 tradeOrderId 查找訂單
  '''
}

// ==================== WC_Order Meta: 金流（綠界 ECPay）====================

Table wc_order_meta_ecpay_payment {
  order_id bigint [ref: > wc_orders.id, note: '訂單 ID']
  _pc_ecpay_trade_no varchar [note: '綠界 MerchantTradeNo（冪等鍵，建單時寫入；ReturnURL/PaymentInfoURL 以此反查訂單）']
  _pc_ecpay_payment_detail json [note: '付款結果明細（ReturnURL 幕後通知寫入；AIO=已驗章參數陣列 / ECPG=AES 解密後的 Data）']
  _pc_ecpay_payment_info json [note: '取號繳費資訊（PaymentInfoURL 通知寫入：BankCode/vAccount/PaymentNo/Barcode1-3/ExpireDate 等）']
  _pc_ecpay_credit_variant varchar [note: "信用卡付款變體（''｜'installment'｜'period'，checkout 顧客選擇寫入）"]
  _pc_ecpay_installment varchar [note: "信用卡分期期數（顧客選擇的單一期數，如 '6'，checkout 寫入）"]

  Note: '''
    綠界 ECPay 金流相關的 Order Meta（AIO + ECPG 共用同一組 meta key）
    對應 .feature: payment/ecpay-aio-checkout、ecpay-aio-callback、ecpay-aio-payment-info、
                   ecpay-ecpg-checkout、ecpay-ecpg-callback、ecpay-credit-variants、ecpay-refund
    透過 Payment\\EcpayAIO\\Shared\\Helpers\\EcpayMetaKeys 類別存取（HPOS 相容，禁用 get_post_meta）
    _pc_ecpay_trade_no 為冪等鍵：幕後通知（ReturnURL/PaymentInfoURL）以 MerchantTradeNo 反查訂單，
    已 processing 則 skip（重送風暴防護）
  '''
}

// ==================== WC_Order Meta: 發票 ====================

Table wc_order_meta_invoice {
  order_id bigint [ref: > wc_orders.id, note: '訂單 ID']
  _pc_issue_invoice_params json [note: '結帳頁填寫的發票資訊（invoiceType, individual, carrier, companyId 等）']
  _pc_issued_invoice_data json [note: '發票開立回傳資料 array（含 invoice_number 等）']
  _pc_cancelled_invoice_data json [note: '發票作廢回傳資料 array']
  _pc_invoice_provider_id invoice_provider [note: '使用的發票 Provider ID（amego ｜ ecpay）']

  Note: '''
    電子發票相關的 Order Meta（Amego 與綠界 ECPay 發票共用同一組 meta key）
    對應 .feature: invoice/invoice-issue、invoice/invoice-cancel
    透過 Invoice\Shared\Helpers\MetaKeys 類別存取
    _pc_invoice_provider_id 值域對應 Enum invoice_provider（amego ｜ ecpay）
    作廢成功時清除 _pc_issue_invoice_params、_pc_issued_invoice_data、_pc_invoice_provider_id
  '''
}

// ==================== WC_Order_Item Meta ====================

Table wc_order_item_meta {
  order_item_id bigint [note: '訂單項目 ID']
  _pc_tax_type int [note: '商品稅別（1=應稅, 2=零稅率, 3=免稅），預設 1']

  Note: '''
    訂單商品項目的稅別
    透過 WC_Order_Item::get_meta("_pc_tax_type") 存取
    對應 Enum tax_type，用於發票開立時計算稅額
  '''
}

// ==================== References ====================

Ref: wc_order_meta_payment.order_id > wc_orders.id
Ref: wc_order_meta_ecpay_payment.order_id > wc_orders.id
Ref: wc_order_meta_invoice.order_id > wc_orders.id
